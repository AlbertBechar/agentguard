# Get a key at https://aistudio.google.com/api-keys
AI_STUDIO_API_KEY=your-key-here
# Optional:
# GEMINI_MODEL=gemini-3.5-flash-lite
# RESET_DB=true
# SHOW_TOOL_CALLS=false   # true = show live logs & tool calls in the chat
# GEMINI_TIMEOUT=120     # seconds to wait for one Gemini call
# GEMINI_RETRIES=1       # retries on timeout / 404 / 429 / 5xx

# --- Other LLM providers (see README, "Άλλοι πάροχοι LLM") ---
# Any OpenAI-compatible /chat/completions endpoint: OpenAI, Anthropic, OpenRouter, Ollama, ...
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-mini
# LLM_MAX_TOKENS=        # optional cap on reply tokens
