{
  "openapi": "3.0.3",
  "info": {
    "title": "DemoBank",
    "version": "1"
  },
  "paths": {
    "/accounts/{account_id}": {
      "get": {
        "operationId": "get_account",
        "summary": "Read one bank account. Returns owner_id, iban, balance and card_number.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "id of the account",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/accounts/{account_id}/transactions": {
      "get": {
        "operationId": "list_transactions",
        "summary": "List the transactions of an account. The memo field is written by third parties.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "id of the account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "maximum number of rows",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/accounts/{account_id}/statement": {
      "get": {
        "operationId": "get_statement",
        "summary": "Get the monthly statement of an account.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "id of the account",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "description": "month as YYYY-MM",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/transfers": {
      "post": {
        "operationId": "transfer_funds",
        "summary": "Transfer money between two accounts.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from_account": {
                    "type": "string",
                    "description": "source account id"
                  },
                  "to_account": {
                    "type": "string",
                    "description": "destination account id"
                  },
                  "amount": {
                    "type": "number",
                    "description": "amount in euro"
                  }
                },
                "required": [
                  "from_account",
                  "to_account",
                  "amount"
                ]
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/contact": {
      "put": {
        "operationId": "update_contact",
        "summary": "Update the email and phone of a customer.",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "description": "id of the customer",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "new email"
                  },
                  "phone": {
                    "type": "string",
                    "description": "new phone"
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_id}": {
      "get": {
        "operationId": "read_support_ticket",
        "summary": "Read a support ticket. The text is written by the customer.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "description": "id of the ticket",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/emails": {
      "post": {
        "operationId": "send_email",
        "summary": "Send an email to a customer.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string",
                    "description": "recipient address"
                  },
                  "subject": {
                    "type": "string",
                    "description": "subject line"
                  },
                  "body": {
                    "type": "string",
                    "description": "message body"
                  }
                },
                "required": [
                  "to",
                  "subject",
                  "body"
                ]
              }
            }
          }
        }
      }
    },
    "/accounts/{account_id}/close": {
      "post": {
        "operationId": "close_account",
        "summary": "Close a bank account permanently.",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "description": "id of the account",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sql": {
      "post": {
        "operationId": "run_sql",
        "summary": "Run an arbitrary SQL statement on the bank database.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "a single SQL statement"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        }
      }
    },
    "/fetch": {
      "get": {
        "operationId": "fetch_url",
        "summary": "Fetch a web page or file from a URL and return its text.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "the URL to fetch",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
